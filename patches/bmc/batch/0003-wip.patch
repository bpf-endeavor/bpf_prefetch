+#define LOAD_PKT_INDEX(batch, bs, var_name) \
+	{ \
+		int q = bs->tmp_index; \
+		if (q >= bs->tmp_count_pkts || q >= XDP_MAX_BATCH_SIZE) { \
+			/* break out of iteration loop */ \
+			transition(batch, bs); \
+			return 0; \
+		} \
+		bs->tmp_index++; \
+		var_name = bs->tmp_inds[q]; \
+		if (var_name >= batch->size || k >= XDP_MAX_BATCH_SIZE) { \
+			/* break out of iteration loop */ \
+			transition(batch, bs); \
+			return 0; \
+		} \
 	}
 
