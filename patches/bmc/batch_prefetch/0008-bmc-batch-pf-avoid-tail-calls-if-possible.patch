-pf_arr_from_hash(batch_state_t *bs, __u32 k)
+init(void)
 {
 	if (_array_map_base == 0) {
 		/* this should happen only once at the beginning of the program
@@ -279,18 +282,30 @@ pf_arr_from_hash(batch_state_t *bs, __u32 k)
