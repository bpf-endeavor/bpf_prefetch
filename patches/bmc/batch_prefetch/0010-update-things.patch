+int glb_compute_ip_checksum(struct xdp_batch_md *batch, __u32 k, __u16 *out)
+{
+	if (out == NULL)
+		return -1;
+	if (k > batch->size)
+		return -1;
+	struct xdp_md *ctx = &batch->buffs[k];
+	void *data = (void *)(long)ctx->data;
+	void *data_end = (void *)(long)ctx->data_end;
+	struct iphdr *ip = data + sizeof(struct ethhdr);
+	__u16 csum = compute_ip_checksum(ip);
+	*out = csum;
+	return 0;
+}
