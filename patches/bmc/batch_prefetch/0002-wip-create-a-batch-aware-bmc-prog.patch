diff --git a/bmc/bmc_kern.c b/bmc/bmc_kern.c
index d15634f..78486ed 100644
--- a/bmc/bmc_kern.c
+++ b/bmc/bmc_kern.c
@@ -25,6 +25,8 @@
 
 #define ADJUST_HEAD_LEN 128
 
+#define SERVER_PORT 11211
+
 #ifndef memmove
 # define memmove(dest, src, n)  __builtin_memmove((dest), (src), (n))
 #endif
@@ -41,6 +43,20 @@ struct memcached_udp_header {
     char data[];
 } __attribute__((__packed__));
 
+/* Some macros to ease working with a batch */
+#define ACTION(act, index) batch->actions[index] = act
+#define PASS(k) ACTION(XDP_PASS, k)
+#define DROP(k) ACTION(XDP_DROP, k)
+#define TX(k)   ACTION(XDP_TX, k)
+
+enum pkt_proc_phase {
+	START,
+	SET_REQ,
+	GET_REQ_HASH_KEY,
+	PREPARE_PACKET,
+	RESPOND,
+	DONE,
+};
 
 /*
  * eBPF maps
@@ -62,12 +78,12 @@ struct memcached_key {
 	unsigned int len;
 };
 
