+/* 	__type(value, struct parsing_context); */
+/* 	__uint(max_entries, 1); */
+/* } map_parsing_context SEC(".maps"); */
+
+typedef struct {
+	struct parsing_context pctx;
+	struct memcached_key key;
+	int phase;
+} pkt_state_t;
+
+typedef struct {
+	pkt_state_t S[XDP_MAX_BATCH_SIZE];
+} batch_state_t;
+
 struct {
 	__uint(type, BPF_MAP_TYPE_PERCPU_ARRAY);
 	__type(key, unsigned int);
-	__type(value, struct parsing_context);
+	__type(value, batch_state_t);
 	__uint(max_entries, 1);
-} map_parsing_context SEC(".maps");
+} map_batch_context SEC(".maps");
 
 /* stats */
 struct {
@@ -122,414 +155,565 @@ static inline __u16 compute_ip_checksum(struct iphdr *ip)
 	return ~((csum & 0xffff) + (csum >> 16));
 }
 
