-} map_keys SEC(".maps");
+/* struct { */
+/* 	__uint(type, BPF_MAP_TYPE_PERCPU_ARRAY); */
+/* 	__type(key, unsigned int); */
+/* 	__type(value, struct memcached_key); */
+/* 	__uint(max_entries, BMC_MAX_KEY_IN_PACKET); */
+/* } map_keys SEC(".maps"); */
 
