+static inline __attribute__((always_inline))
+void DEFINE_PHASE(int name, struct xdp_batch_md *batch, batch_state_t *bs)
+{
+	bs->tmp_index = 0;
+	bs->tmp_count_pkts = 0;
+	__u32 count_pkts = 0;
+	for (__u32 k = 0; k < XDP_MAX_BATCH_SIZE; k++) {
+		if (k >= batch->size)
+			break;
+		if (bs->S[k].phase == name) {
+			if (count_pkts >= XDP_MAX_BATCH_SIZE) {
+				bpf_printk("how is this possible!!!");
+				return;
+			}
+			bs->tmp_inds[count_pkts] = k;
+			count_pkts++;
+		}
+	}
+	bs->tmp_count_pkts = count_pkts;
