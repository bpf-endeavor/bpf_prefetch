From 79737ceb5fd7b174b7d8380f7f1847c3c24c5676 Mon Sep 17 00:00:00 2001
From: Farbod Shahinfar <fshahinfar1@gmail.com>
Date: Sun, 1 Sep 2024 11:52:15 +0000
Subject: [PATCH] wip: trying to add a basic sw prefetcher to BPF JIT x86

---
 arch/x86/net/bpf_jit_comp.c | 228 ++++++++++++++++++++++++++++++++++++
 kernel/bpf/Kconfig          |   7 ++
 2 files changed, 235 insertions(+)

diff --git a/arch/x86/net/bpf_jit_comp.c b/arch/x86/net/bpf_jit_comp.c
index 919f647c740f..af01e6a3b93d 100644
--- a/arch/x86/net/bpf_jit_comp.c
+++ b/arch/x86/net/bpf_jit_comp.c
@@ -18,6 +18,24 @@
 #include <asm/text-patching.h>
 #include <asm/unwind.h>
 #include <asm/cfi.h>
+#include <linux/list.h>
+
+#ifdef CONFIG_BPF_JIT_PREFETCH
+/* BPF_PREFETCH  is defined as follows.
+ * Its opcode is defined as LDX class with ATOMIC mode and the size is DW.
+ * The src_reg holds the base register used in prefetching.
+ * The dst_reg must be zero
+ * The imm would hold the offset value of memory address.
+ * */
+#define BPF_PREFETCH (BPF_LDX | BPF_ATOMIC |BPF_DW)
+static inline bool __is_bpf_prefetch(struct bpf_insn *i)
+{
+	if ((i->code == BPF_PREFETCH) && (i->dst_reg == 0x0)) {
+		return true;
+	}
+	return false;
+}
+#endif
 
 static bool all_callee_regs_used[4] = {true, true, true, true};
 
@@ -2041,6 +2059,23 @@ st:			if (is_imm8(insn->off))
 			emit_return(&prog, image + addrs[i - 1] + (prog - temp));
 			break;
 
+#ifdef CONFIG_BPF_JIT_PREFETCH
+		case BPF_PREFETCH:
+			if (insn->dst_reg != 0x0) {
+				pr_err("bpf_jit: invalid prefetch instruction");
+				return -EINVAL;
+			}
+			int off = insn->imm;
+			/* if (off != 0x0) { */
+			/* 	/1* skip prefetch instructions that have an offset for now *1/ */
+			/* 	break; */
+			/* } */
+			EMIT2(0x0F, 0x18);
+			emit_insn_suffix(&prog, insn->src_reg, 0, off);
+			printk("emit prefetch instruction\n");
+			break;
+#endif
+
 		default:
 			/*
 			 * By design x86-64 JIT should support all BPF instructions.
@@ -2929,6 +2964,186 @@ int arch_prepare_bpf_dispatcher(void *image, void *buf, s64 *funcs, int num_func
 	return emit_bpf_dispatcher(&prog, 0, num_funcs - 1, funcs, image, buf);
 }
 
+#ifdef CONFIG_BPF_JIT_PREFETCH
+#define PREFETCH_K 3
+#define MAX_PREFETCH_INST 1024
+struct linst {
+	struct linst *next;
+	struct linst *prev;
+	struct bpf_insn inst;
+};
+
+static inline void __append(struct linst *cur, struct linst *new)
+{
+		new->next = cur->next;
+		cur->next = new;
+		new->prev = cur;
+}
+
+static int __find_latest_reg_assign(struct linst *head, struct linst *end,
+		__u8 reg, struct linst **out)
+{
+	struct linst *cur = NULL;
+	struct linst *match = NULL;
+	for (cur = head; cur->next != end; cur = cur->next) {
+		if (cur->inst.dst_reg != reg) {
+			continue;
+		}
+		int op = cur->inst.code;
+		if (BPF_CLASS(op) != BPF_LDX && BPF_CLASS(op) != BPF_ALU &&
+				BPF_CLASS(op) != BPF_ALU64) {
+			continue;
+		}
+		match = cur;
+	}
+	if (match == NULL) {
+		return -1;
+	}
+	*out = cur;
+	return 0;
+}
+
+static int __inst_distance(struct linst *a, struct linst *b)
+{
+	int dist = 0;
+	struct linst *cur = NULL;
+	for (cur = a; cur !=b; cur = cur->next) {
+		dist++;
+		if (cur->next == a) {
+			/* Traversed a full loop and did not found `b' ! */
+			return -1;
+		}
+	}
+	return dist;
+}
+
+static inline void __prepare_prefetch_inst(struct linst *p, struct linst *load)
+{
+	p->inst.code = BPF_PREFETCH;
+	p->inst.dst_reg = 0x0;
+	p->inst.src_reg = load->inst.src_reg;
+	p->inst.imm = load->inst.imm;
+}
+
+static struct bpf_prog *__bpf_prog_clone_create(struct bpf_prog *fp_other,
+					      gfp_t gfp_extra_flags)
+{
+	gfp_t gfp_flags = GFP_KERNEL | __GFP_ZERO | gfp_extra_flags;
+	struct bpf_prog *fp;
+
+	fp = __vmalloc(fp_other->pages * PAGE_SIZE, gfp_flags);
+	if (fp != NULL) {
+		/* aux->prog still points to the fp_other one, so
+		 * when promoting the clone to the real program,
+		 * this still needs to be adapted.
+		 */
+		memcpy(fp, fp_other, fp_other->pages * PAGE_SIZE);
+	}
+
+	return fp;
+}
+
+static struct bpf_prog *bpf_jit_prefetch(struct bpf_prog *prog)
+{
+	if (prog->len == 0)
+		return prog;
+
+	int ret = 0;
+
+	/* Allocate linked list elements */
+	struct linst *tmp = kzalloc(prog->len * sizeof(struct linst),
+			GFP_KERNEL);
+	if (tmp == NULL)
+		return ERR_PTR(-ENOMEM);
+	struct linst *ptmp = kzalloc(MAX_PREFETCH_INST * sizeof(struct linst),
+			GFP_KERNEL);
+	if (ptmp == NULL)
+		return ERR_PTR(-ENOMEM);
+	int num_add_prefetch = 0;
+
+	/* Convert instruction array to a linked list */
+	struct linst *head = &tmp[0];
+	head->next = head;
+	head->prev = head;
+	struct linst *cur = head;
+	cur->inst = prog->insnsi[0];
+	for (int i = 1; i < prog->len; i++) {
+		struct linst *new = &tmp[i];
+		new->inst = prog->insnsi[i];
+		__append(cur, new);
+		cur = new;
+	}
+
+	/* Go through instructions. Find instructions that load from memory.
+	 * Find the latest assignment to the base register they use.
+	 * If the distance between assignment and load instruction is more than
+	 * K, then attempt to prefetch the memory address K instruction before
+	 * loading it.
+	 * */
+	for (cur = head; cur->next != head; cur = cur->next) {
+		/* NOTE: FIXME: This loop will skip the last element! */
+		__u8 opcode = cur->inst.code;
+		if (!(  opcode == (BPF_LDX | BPF_MEM | BPF_DW) ||
+			opcode == (BPF_LDX | BPF_MEM | BPF_W)  ||
+			opcode == (BPF_LDX | BPF_MEM | BPF_H)  ||
+			opcode == (BPF_LDX | BPF_MEM | BPF_B) )) {
+			continue;
+		}
+		printk("Found a load instruction\n");
+		/* The operation is: dst = *(unsigned size *) (src + offset)
+		 * we are attempting to prefetch (src + offset).
+		 * */
+		struct linst *last_ass;
+		ret = __find_latest_reg_assign(head, cur, cur->inst.src_reg, &last_ass);
+		if (ret != 0) {
+			printk("Unexpected: Failed to find the latest assignment to register!\n");
+			continue;
+		}
+		int dist = __inst_distance(last_ass, cur);
+		printk("Load inst distance from last assignment is %d\n", dist);
+		if (dist < PREFETCH_K)
+			continue;
+		/* Find a instruction K before load instruction */
+		struct linst *k_before = cur;
+		for (int i = 0; i < PREFETCH_K; i++) {
+			k_before = k_before->prev;
+		}
+
+		/* Insert a prefetch instruction */
+		if (num_add_prefetch >= MAX_PREFETCH_INST) {
+			printk("Unexpected: all prefetch instruction has been used!\n");
+			continue;
+		}
+		struct linst *p = &ptmp[num_add_prefetch];
+		num_add_prefetch++;
+		__prepare_prefetch_inst(p, cur);
+		__append(k_before, p);
+	}
+
+	/* Clone bpf_prog structure */
+	struct bpf_prog *new_prog = __bpf_prog_clone_create(prog, GFP_USER);
+	if (!new_prog) {
+		kfree(tmp);
+		kfree(ptmp);
+		return ERR_PTR(-ENOMEM);
+	}
+	/* Convert linked list to struct bpf_prog */
+	int cnt_inst = 0;
+	for (cur = head; cur->next != head; cur = cur->next) {
+		new_prog->insnsi[cnt_inst] = cur->inst;
+		cnt_inst++;
+	}
+	new_prog->insnsi[cnt_inst] = cur->inst;
+	cnt_inst++;
+	new_prog->len = cnt_inst;
+	printk("The new program has %d instructions (orig: %d)", cnt_inst, prog->len);
+
+	kfree(tmp); /* memory for linked list elements holding original instructions */
+	kfree(ptmp); /* memory for added prefetch instruction */
+	return new_prog;
+}
+#endif
+
 struct x64_jit_data {
 	struct bpf_binary_header *rw_header;
 	struct bpf_binary_header *header;
@@ -2973,6 +3188,19 @@ struct bpf_prog *bpf_int_jit_compile(struct bpf_prog *prog)
 		prog = tmp;
 	}
 
+#ifdef CONFIG_BPF_JIT_PREFETCH
+	/* Farbod: pass program to JIT prefetching analyser */
+	printk("Farbod: at JIT prefetch pass\n");
+	tmp = bpf_jit_prefetch(prog);
+	if (IS_ERR(tmp)) {
+		printk("Failed in JIT prefetch pass\n");
+		return orig_prog;
+	}
+	if (tmp != prog) {
+		prog = tmp;
+	}
+#endif
+
 	jit_data = prog->aux->jit_data;
 	if (!jit_data) {
 		jit_data = kzalloc(sizeof(*jit_data), GFP_KERNEL);
diff --git a/kernel/bpf/Kconfig b/kernel/bpf/Kconfig
index 6a906ff93006..089320ab77a0 100644
--- a/kernel/bpf/Kconfig
+++ b/kernel/bpf/Kconfig
@@ -86,6 +86,13 @@ config BPF_UNPRIV_DEFAULT_OFF
 
 	  If you are unsure how to answer this question, answer Y.
 
+config BPF_JIT_PREFETCH
+	  bool "Enable prefetch instruction in BPF JIT"
+	  depends on HAVE_EBPF_JIT
+	  default n
+	  help
+	  Enable prefetch instruction in BPF JIT
+
 source "kernel/bpf/preload/Kconfig"
 
 config BPF_LSM
-- 
