+void *BaseBpfAdapter::getMapMMapAreaByName(const std::string name, size_t *out_map_sz)
+{
+  int ret = 0;
+  int fd = getMapFdByName(name); // struct bpf_map *
+  if (fd < 0) {
+    LOG(ERROR) << "can't find ``" << name << "'' map, error: "
+                                          << folly::errnoStr(errno);
+    throw std::runtime_error("failed to find Arena map");
+  }
+  struct bpf_map_info map_info = {};
+  ret = getBpfMapInfo(fd, &map_info);
+  if (ret != 0) {
+    LOG(ERROR) << "Failed to get bpf map info" << std::endl;
+    throw std::runtime_error("failed to get bpf map info");
+  }
+
+  size_t value_size = (size_t)map_info.value_size;
+  if (map_info.type == BPF_MAP_TYPE_ARENA) {
+    size_t page_size = sysconf(_SC_PAGE_SIZE);
+    value_size = page_size;
+  }
+
+  if ((map_info.map_flags & BPF_F_MMAPABLE) == 0) {
+    LOG(ERROR) << "Map is not mmapable!" << std::endl;
+    throw std::runtime_error("selected map is not mmapable");
+  }
+
+  const size_t map_sz = value_size * (map_info.max_entries);
+
+  const void * begin_addr = map_info.map_extra;
+  int flag = MAP_SHARED;
+  if (begin_addr != NULL) {
+    flag |= MAP_FIXED;
+  }
+
+  void *area = mmap(begin_addr, map_sz, PROT_READ | PROT_WRITE, flag, fd, 0);
+
+  if (area == MAP_FAILED) {
+    LOG(ERROR) << "err code:" << errno << std::endl;
+    LOG(ERROR) << "arena fd: " << fd << std::endl;
+    LOG(ERROR) << "map info:  val size: " << map_info.value_size
+        << "  max entries: " << map_info.max_entries << std::endl;
+    LOG(ERROR) << "map extra: " << map_info.map_extra << std::endl;
+    LOG(ERROR) << "failed to mmap, size:" << map_sz << std::endl;
+    *out_map_sz = 0;
+    return nullptr;
+  }
+
+  *out_map_sz = map_sz;
+  return area;
+}
