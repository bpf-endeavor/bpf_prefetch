+/* Batch processing state */
+enum pkt_phase {
+  START = 100,
+  PARSE_HEADER,
+  FIND_VIP,
+  SERVER_ID_MATCHING,
+  LRU_LOOKUP,
+  CONSISTENT_HASH,
+  ENCAP_AND_TX,
+  TCP_HDR_OPT_LOOKUP_2,
+
+  DONE,
+};
+
+struct pkt_state {
+  bool is_ipv6;
+  enum pkt_phase phase;
+  struct packet_description pckt;
+  struct vip_definition vip;
+  __u32 vip_num;
+  __u16 nh_off;
+  __u16 original_sport;
+  __u16 pkt_bytes;
+
+  // dst variable may be NULL across multiple sections (depending on how we
+  // find the destination server). so I need to track its validity
+  struct {
+    bool is_valid;
+    struct real_definition data;
+  } dst;
+
+  // if we don't find vip we drop packet so we don't need to track its validity
+  struct vip_meta vip_info;
+
+  __u32 cpu_num;
+  __u32 server_id;
+};
+typedef struct pkt_state pkt_state_t;
+
+struct batch_state {
+  pkt_state_t S[XDP_MAX_BATCH_SIZE];
+};
+typedef struct batch_state batch_state_t;
 #endif // of _BALANCER_STRUCTS
