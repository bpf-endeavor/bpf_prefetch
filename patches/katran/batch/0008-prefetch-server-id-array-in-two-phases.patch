+static inline __attribute__((always_inline))
+void __prefetch_server_id_map(__u32 server_id)
+{
+  __u64 off = server_id * sizeof(__u32);
+  __u64 addr = server_id_map_base + off;
+  void *ptr = (void *)addr;
+  P(ptr);
+}
+
+static inline __attribute__((always_inline))
+void __init(void)
+{
+  int zero = 0;
+  if (server_id_map_base == 0) {
+    void* ptr = bpf_map_lookup_elem(&server_id_map, &zero);
+    if (!ptr)
+      return;
+   server_id_map_base = (__u64)ptr;
+  }
