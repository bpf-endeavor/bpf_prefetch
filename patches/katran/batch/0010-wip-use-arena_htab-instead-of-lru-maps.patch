   maps.push_back(KatranLbMaps::vip_to_down_reals_map);
 
 #ifdef USE_HTAB_FOR_VIP_MAP
-  maps.push_back(KatranLbMaps::vip_map_htab);
+  maps.push_back(KatranLbMaps::htab_ptr_map);
   maps.push_back(KatranLbMaps::arena);
 #endif
 
@@ -479,7 +480,7 @@ void KatranLb::initLrus(bool flowDebug, bool globalLru) {
     if (numaNodes_.size() != 0) {
       if (numaNodes_.size() != forwardingCores_.size()) {
         throw std::runtime_error(
-            "numaNodes size mut be equal to forwardingCores");
+            "numaNodes size must be equal to forwardingCores");
       }
       numa_mapping_specified = true;
     }
@@ -763,7 +764,9 @@ void KatranLb::loadBpfProgs() {
       config_.balancerProgPath, KatranLbMaps::flow_debug_maps);
   globalLruInProg = bpfAdapter_->isMapInBpfObject(
       config_.balancerProgPath, KatranLbMaps::global_lru_maps);
+#ifndef USE_HTAB_FOR_LRU_MAP
   initLrus(flowDebugInProg, globalLruInProg);
+#endif
   if (flowDebugInProg) {
     initFlowDebugPrototypeMap();
   }
@@ -839,7 +842,9 @@ void KatranLb::loadBpfProgs() {
     introspectionStarted_ = true;
   }
 
+#ifndef USE_HTAB_FOR_LRU_MAP
   attachLrus(flowDebugInProg, globalLruInProg);
+#endif
 
   vip_definition vip_def;
   memset(&vip_def, 0, sizeof(vip_definition));
@@ -853,7 +858,7 @@ void KatranLb::loadBpfProgs() {
                << folly::errnoStr(errno);
   }
 
-#ifdef USE_HTAB_FOR_VIP_MAP
+#if defined(USE_HTAB_FOR_VIP_MAP) || defined(USE_HTAB_FOR_LRU_MAP)
   /// Initialize Arena htab
   void *htab_ptr = nullptr;
 
@@ -866,22 +871,63 @@ void KatranLb::loadBpfProgs() {
     throw std::runtime_error("failed to memory map arena");
   }
 
-  const uint32_t max_entries = 512; // MAX_VIPS default: 512
   const size_t page_size = sysconf(_SC_PAGE_SIZE);
+  uint32_t used_pages = 0;
+  uint32_t total_used_pages = 0;
+  size_t offset = 0;
+  int htab_ptr_map_fd = bpfAdapter_->getMapFdByName(KatranLbMaps::htab_ptr_map);
+
+#ifdef USE_HTAB_FOR_VIP_MAP
+  const uint32_t max_entries = 512; // MAX_VIPS default: 512
   if (max_entries * page_size > arena_sz) {
     LOG(ERROR) << "Arena map does not have enough pages"  << std::endl;
     throw std::runtime_error("failed to populate arena map!");
   }
 
   // use the helper function from the library to initialize the htab
-  htab_init_userspace(area, max_entries, &htab_ptr);
+  used_pages = 0;
+  htab_init_userspace_2(area, max_entries, &htab_ptr, &used_pages);
   htab_ = (void *)htab_ptr;
-  LOG(INFO) << "init htab_ addr: " << htab_ << std::endl;
+
+  LOG(INFO) << "Arena: used pages: " << used_pages << std::endl;
+  total_used_pages += used_pages;
 
   // write the pointer to the map
   int zero = 0;
-  int htab_ptr_map_fd = bpfAdapter_->getMapFdByName(KatranLbMaps::vip_map_htab);
   bpfAdapter_->bpfUpdateMap(htab_ptr_map_fd, &zero, &htab_ptr, BPF_ANY);
+#endif
+
+#ifdef USE_HTAB_FOR_LRU_MAP
+  const uint32_t per_core_lru_size = config_.LruSize / forwardingCores_.size();
+  for (int i = 0; i < forwardingCores_.size(); i++) {
+    auto core = forwardingCores_[i];
+    if ((core > kMaxForwardingCores) || core < 0) {
+      LOG(FATAL) << "got core# " << core
+        << " which is not in supported range: [ 0: "
+        << kMaxForwardingCores << " ]";
+      throw std::runtime_error("unsuported number of forwarding cores");
+    }
+
+    offset = total_used_pages * page_size;
+    if (offset > arena_sz) {
+      throw std::runtime_error("not enough arena memory!");
+    }
+
+    void *tmp_area = area + offset;
+    used_pages = 0;
+    htab_init_userspace_2(tmp_area, per_core_lru_size, &htab_ptr, &used_pages);
+
+    LOG(INFO) << "Arena: used pages: " << used_pages << std::endl;
+    total_used_pages += used_pages;
+    if (total_used_pages * page_size > arena_sz) {
+      throw std::runtime_error("not enough arena memory (2)!");
+    }
+
+    uint32_t key = core + 1;
+    bpfAdapter_->bpfUpdateMap(htab_ptr_map_fd, &key, &htab_ptr, BPF_ANY);
+  }
+#endif
+
   // -------------
 #endif
 }
