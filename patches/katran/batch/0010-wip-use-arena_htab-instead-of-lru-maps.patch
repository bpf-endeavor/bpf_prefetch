--- a/katran/lib/KatranLb.cpp
+++ b/katran/lib/KatranLb.cpp
@@ -37,6 +37,7 @@
 #include "katran/lib/KatranMonitor.h"
 
 #define USE_HTAB_FOR_VIP_MAP
