 #include "katran/lib/bpf/pckt_encap.h"
 #include "katran/lib/bpf/pckt_parsing.h"
 
+/* Some macros to ease working with a batch */
+#define ACTION(act, index) batch->actions[index] = act
+#define PASS(k) ACTION(XDP_PASS, k)
+#define DROP(k) ACTION(XDP_DROP, k)
+#define TX(k)   ACTION(XDP_TX, k)
+
+#define PREFETCH 1
+#include "honey/prefetching.h"
+
+
+/* Batch processing state */
+enum pkt_phase {
+  START = 100,
+  PARSE_HEADER,
+  FIND_VIP,
+  SERVER_ID_MATCHING,
+  LRU_LOOKUP,
+  CONSISTENT_HASH,
+  ENCAP_AND_TX,
+  DONE,
+};
+
+struct pkt_state {
+  bool is_ipv6;
+  enum pkt_phase phase;
+  struct packet_description pckt;
+  struct vip_definition vip;
+  __u32 vip_num;
+  __u16 nh_off;
+  __u16 original_sport;
+  __u16 pkt_bytes;
+};
+typedef struct pkt_state pkt_state_t;
+
+struct batch_state {
+  pkt_state_t S[XDP_MAX_BATCH_SIZE];
+};
+typedef struct batch_state batch_state_t;
+
+struct {
+  __uint(type, BPF_MAP_TYPE_ARRAY);
+  __type(key, int);
+  __type(value, batch_state_t);
+  __uint(max_entries, 1);
+  __uint(map_flags, NO_FLAGS);
+} batch_state_map SEC(".maps");
+
+static inline __attribute__((always_inline))
+batch_state_t *get_batch_state(void)
+{
+  int zero = 0;
+  batch_state_t *bs = bpf_map_lookup_elem(&batch_state_map, &zero);
+  return bs;
+}
+
+#define LOAD_BATCH_STATE() \
+  batch_state_t *bs = get_batch_state(); \
+  if (bs == NULL) { bpf_printk("failed to load batch state"); return XDP_ABORTED; }
+
