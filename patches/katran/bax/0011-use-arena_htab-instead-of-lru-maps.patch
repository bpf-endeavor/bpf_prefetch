From 236fc18d9ea11ceaa97667bbce52635ecee6ce32 Mon Sep 17 00:00:00 2001
From: Farbod Shahinfar <fshahinfar1@gmail.com>
Date: Tue, 4 Nov 2025 10:14:50 -0700
Subject: [PATCH 11/13] use arena_htab instead of lru-maps

---
 katran/lib/KatranLb.cpp       |  1 +
 katran/lib/bpf/balancer.bpf.c | 99 +++++++++++++++++++++++++----------
 2 files changed, 71 insertions(+), 29 deletions(-)

diff --git a/katran/lib/KatranLb.cpp b/katran/lib/KatranLb.cpp
index efa06f35..83cc1fb7 100644
--- a/katran/lib/KatranLb.cpp
+++ b/katran/lib/KatranLb.cpp
@@ -925,6 +925,7 @@ void KatranLb::loadBpfProgs() {
 
     uint32_t key = core + 1;
     bpfAdapter_->bpfUpdateMap(htab_ptr_map_fd, &key, &htab_ptr, BPF_ANY);
+    LOG(INFO) << "create htab at key: " << key << std::endl;
   }
 #endif
 
diff --git a/katran/lib/bpf/balancer.bpf.c b/katran/lib/bpf/balancer.bpf.c
index 6f114f83..e834d6ed 100644
--- a/katran/lib/bpf/balancer.bpf.c
+++ b/katran/lib/bpf/balancer.bpf.c
@@ -54,8 +54,8 @@ typedef struct vip_meta my_value_t;
 struct {
   __uint(type, BPF_MAP_TYPE_ARENA);
   __uint(map_flags, BPF_F_MMAPABLE);
-  __uint(max_entries, 100000); /* number of pages */
-  __uint(map_extra, 0x500000);
+  __uint(max_entries, 200000); /* number of pages */
+  __uint(map_extra, 0x500000); /* address at which arena is mapped */
 } arena SEC(".maps");
 #include "arena-ds/htab.h"
 
@@ -296,7 +296,12 @@ __attribute__((__always_inline__)) static inline bool get_packet_dst(
     struct packet_description* pckt,
     struct vip_meta* vip_info,
     bool is_ipv6,
-    void* lru_map) {
+#ifdef USE_HTAB_FOR_LRU_MAP
+    htab_t *lru_map
+#else
+    void* lru_map
+#endif
+    ) {
   // to update lru w/ new connection
   struct real_pos_lru new_dst_lru = {};
   bool under_flood = false;
@@ -375,7 +380,11 @@ __attribute__((__always_inline__)) static inline bool get_packet_dst(
       new_dst_lru.atime = cur_time;
     }
     new_dst_lru.pos = key;
+#ifdef USE_HTAB_FOR_LRU_MAP
+    htab_update_elem(lru_map, &pckt->flow, &new_dst_lru);
+#else
     bpf_map_update_elem(lru_map, &pckt->flow, &new_dst_lru, BPF_ANY);
+#endif
   }
   return true;
 }
@@ -383,12 +392,21 @@ __attribute__((__always_inline__)) static inline bool get_packet_dst(
 __attribute__((__always_inline__)) static inline void connection_table_lookup(
     struct real_definition** real,
     struct packet_description* pckt,
+#ifdef USE_HTAB_FOR_LRU_MAP
+    htab_t* lru_map,
+#else
     void* lru_map,
+#endif
     bool isGlobalLru) {
-  struct real_pos_lru* dst_lru;
   __u64 cur_time;
   __u32 key;
+#ifdef USE_HTAB_FOR_LRU_MAP
+  struct real_pos_lru __arena * dst_lru;
+  dst_lru = htab_lookup_elem(lru_map, &pckt->flow);
+#else
+  struct real_pos_lru* dst_lru;
   dst_lru = bpf_map_lookup_elem(lru_map, &pckt->flow);
+#endif
   if (!dst_lru) {
     return;
   }
@@ -822,8 +840,17 @@ __attribute__((__always_inline__)) static inline int update_vip_lru_miss_stats(
 __attribute__((__always_inline__)) static inline int
 check_and_update_real_index_in_lru(
     struct packet_description* pckt,
-    void* lru_map) {
+#ifdef USE_HTAB_FOR_LRU_MAP
+    htab_t *lru_map
+#else
+    void* lru_map
+#endif
+    ) {
+#ifdef USE_HTAB_FOR_LRU_MAP
+  struct real_pos_lru __arena * dst_lru = htab_lookup_elem(lru_map, &pckt->flow);
+#else
   struct real_pos_lru* dst_lru = bpf_map_lookup_elem(lru_map, &pckt->flow);
+#endif
   if (dst_lru) {
     if (dst_lru->pos == pckt->real_index) {
       return DST_MATCH_IN_LRU;
@@ -838,7 +865,11 @@ check_and_update_real_index_in_lru(
   }
   struct real_pos_lru new_dst_lru = {};
   new_dst_lru.pos = pckt->real_index;
+#ifdef USE_HTAB_FOR_LRU_MAP
+  htab_update_elem(lru_map, &pckt->flow, &new_dst_lru);
+#else
   bpf_map_update_elem(lru_map, &pckt->flow, &new_dst_lru, BPF_ANY);
+#endif
   return DST_NOT_FOUND_IN_LRU;
 }
 
@@ -903,7 +934,7 @@ htab_t *__lookup_htab_ptr(__u32 key)
   void *tmp = *(void **)ptr;
   if (tmp == NULL) {
     // we have some issue in user-space program
-    bpf_printk("arena htab is not initialized!");
+    bpf_printk("arena htab is not initialized! (key: %d)", key);
     // make sure arena is associated with this program
     my_kfunc_reg_arena(&arena);
   }
@@ -947,7 +978,7 @@ int bbb_balancer_ingress(struct xdp_batch_md* batch)
 
   if (count_packets > BATCH_SIZE) {
     bpf_printk("Error: miss configuration driver's batch size is larger than Katran's!");
-    return 0;
+    goto skip_balancer;
   }
 
   struct lb_stats* data_stats;
@@ -956,31 +987,31 @@ int bbb_balancer_ingress(struct xdp_batch_md* batch)
   data_stats = bpf_map_lookup_elem(&stats, &stats_key);
   if (!data_stats) {
     // this must never happen
-    return 0;
+    goto skip_balancer;
   }
 
-    const __u32 cpu_num = bpf_get_smp_processor_id();
+  const __u32 cpu_num = bpf_get_smp_processor_id();
 #ifdef USE_HTAB_FOR_LRU_MAP
-    void __arena * lru_map = __get_lru_map(cpu_num);
-    if (!lru_map) {
-      return 0;
-    }
+  void __arena * lru_map = __get_lru_map(cpu_num);
+  if (!lru_map) {
+    goto skip_balancer;
+  }
 #else
-    void* lru_map = bpf_map_lookup_elem(&lru_mapping, &cpu_num);
-    if (!lru_map) {
-      // Farbod: I disabled fallback cache
-      /* lru_map = &fallback_cache; */
-      __u32 lru_stats_key = MAX_VIPS + FALLBACK_LRU_CNTR;
-      struct lb_stats* lru_stats = bpf_map_lookup_elem(&stats, &lru_stats_key);
-      if (!lru_stats) {
-        return 0;
-      }
-      // We were not able to retrieve per cpu/core lru and falling back to
-      // default one. This counter should never be anything except 0 in prod.
-      // We are going to use it for monitoring.
-      lru_stats->v1 += 1;
-      return 0;
-    }
+  void* lru_map = bpf_map_lookup_elem(&lru_mapping, &cpu_num);
+  if (!lru_map) {
+    // Farbod: I disabled fallback cache
+    /* lru_map = &fallback_cache; */
+    __u32 lru_stats_key = MAX_VIPS + FALLBACK_LRU_CNTR;
+    struct lb_stats* lru_stats = bpf_map_lookup_elem(&stats, &lru_stats_key);
+    if (!lru_stats) {
+      goto skip_balancer;
+    }
+    // We were not able to retrieve per cpu/core lru and falling back to
+    // default one. This counter should never be anything except 0 in prod.
+    // We are going to use it for monitoring.
+    lru_stats->v1 += 1;
+    goto skip_balancer;
+  }
 #endif
 
 
@@ -1540,6 +1571,14 @@ int bbb_balancer_ingress(struct xdp_batch_md* batch)
   bpf_printk("failed tail call");
 
   return 0;
+
+skip_balancer:
+  /* Farbod: we jump here if something has gone really wrong in ctrl-plane ||
+   * data plane interaction! */
+  for (int k = 0; k < XDP_MAX_BATCH_SIZE && k < batch->size; k++) {
+    PASS(k);
+  }
+  return 0;
 }
 
 SEC(PROG_SEC_NAME)
@@ -1597,7 +1636,9 @@ int bbb_consistent_hashing(struct xdp_batch_md* batch)
       }
 
       /* bpf_printk("doing hashing"); */
-      if (!get_packet_dst(&dst, &pstate->pckt, vip_info, pstate->is_ipv6, lru_map)) {
+      int res = get_packet_dst(&dst, &pstate->pckt, vip_info, pstate->is_ipv6,
+          lru_map);
+      if (!res) {
         /* bpf_printk("failed to get packet dst"); */
         DROP_AND_CONTINUE();
       }
-- 
2.34.1

