+htab_t *__get_vip_map(void)
+{
+  int zero = 0;
+  void *ptr = bpf_map_lookup_elem(&vip_map_htab, &zero);
+  if (ptr == NULL) {
+    // this must never happen!
+    return NULL;
+  }
+
+  // ptr is a pointer to addrses of htab :)
+  void *tmp = *(void **)ptr;
