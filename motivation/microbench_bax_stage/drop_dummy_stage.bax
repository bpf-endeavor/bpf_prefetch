// vim: et ts=4 sw=4 filetype=c:
#include <stdint.h>
#include <stdbool.h>

#include <linux/bpf.h>
#include <bpf/bpf_helpers.h>
#include <bpf/bpf_endian.h>

#include <linux/ip.h>
#include <linux/udp.h>
#include <linux/tcp.h>
#include <linux/in.h>
#include <linux/if_ether.h>

#include "include/shared_struct.h"
#include "include/xdp_helpers.h"

#define PREFETCH /* Enable prefetching helpers */
#include "honey/prefetching.h"
#include "honey/report_throughput.h"

/* Import BAX Framework ---------------------------------------------------- */
/* The state we maintain per each packet */
typedef struct {
    int phase[0]; /* the phase is mandetory */
} pkt_state_t;

__u64 tmp = 0;

/* import BAX DSL */
#include "bax/bax.h"
BAX_DECLARE_INIT_STAGE_NAME(FIRST);
/* ------------------------------------------------------------------------- */

#define DUMMY_COUNT 4

SEC("xdp")
int bbb_test_main(struct xdp_batch_md *batch)
{
    BAX_PROG_BEGIN();
    BAX_INIT_BATCH_STATE();

    BAX_STAGE(FIRST, `{
            tmp++;
        BAX_NEXT_STAGE(DUMMY_1);
    }')

#if (DUMMY_COUNT >= 1)
    BAX_STAGE(DUMMY_1, `{
    #if (DUMMY_COUNT == 1)
        DROP();
    #else
        BAX_NEXT_STAGE(DUMMY_2);
    #endif
    }')

    #if (DUMMY_COUNT >=2)
    BAX_STAGE(DUMMY_2, `{
    #if (DUMMY_COUNT == 2)
        DROP();
    #else
        BAX_NEXT_STAGE(DUMMY_3);
    #endif
    }')

    #if (DUMMY_COUNT >=3)
    BAX_STAGE(DUMMY_3, `{
    #if (DUMMY_COUNT == 3)
        DROP();
    #else
        BAX_NEXT_STAGE(DUMMY_4);
    #endif
    }')


    #if (DUMMY_COUNT >=4)
    BAX_STAGE(DUMMY_4, `{
    #if (DUMMY_COUNT == 4)
        DROP();
    #else
        BAX_NEXT_STAGE(DUMMY_5);
    #endif
    }')


#endif // >= 4
#endif // >= 3
#endif // >= 2
#endif // >= 1

    report_tput_batch(batch_size);

    return 0;
}

BAX_END_OF_FILE()
char _license[] SEC("license") = "GPL";
